# ─────────────────────────────────────────────────────────────────────────────
# AI Call Processing — environment template
# Copy to `.env` and fill in. NEVER commit real keys (.env is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info          # debug | info | warn | error
# Logs are structured JSON (pino). Pipe through `pino-pretty` in dev if desired.

# ── LLM provider selection ──────────────────────────────────────────────────
# The service is provider-agnostic. Pick ONE provider and set its key.
# Default is `gemini` (Google AI Studio offers a free tier).
#   gemini    → set GEMINI_API_KEY
#   openai    → set OPENAI_API_KEY
#   anthropic → set ANTHROPIC_API_KEY
#   fake      → no key needed (deterministic; used by tests/CI)
LLM_PROVIDER=gemini

# Provider API keys — set ONLY the one for your chosen LLM_PROVIDER.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Model selection (optional) ──────────────────────────────────────────────
# Each provider has a sensible default below. LLM_MODEL, if set, overrides the
# per-provider default regardless of which provider is active.
# LLM_MODEL=
# GEMINI_MODEL=gemini-2.5-flash-lite      # or pin: gemini-2.5-flash-lite-preview-09-2025
# OPENAI_MODEL=gpt-5.4-mini                # high volume? gpt-5.4-nano is ~90% cheaper
#                                          # (weaker reasoning — see docs/SETUP.md)
# ANTHROPIC_MODEL=claude-haiku-4-5         # or pin: claude-haiku-4-5-20251001

# ── Endpoint overrides (optional) ───────────────────────────────────────────
# Default to the public API. Override for a proxy / Azure OpenAI / gateway, or
# to point tests at a mock server.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_API_VERSION=2023-06-01

# ── LLM tuning ──────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0           # low → deterministic extraction
LLM_MAX_OUTPUT_TOKENS=1024  # extraction JSON is small; cap to bound cost
LLM_TIMEOUT_MS=3000         # per-call timeout (safety net). Real calls ~1s.
                            #   voice/real-time: 3000 · slow link/free tier: 8000 · batch: 15000
                            #   a timeout fails fast (no retry) → 504

# ── Input guards / cost control ─────────────────────────────────────────────
MAX_TRANSCRIPT_CHARS=20000          # above this → 413 Payload Too Large
MIN_MEANINGFUL_TRANSCRIPT_CHARS=15  # below this → skip the LLM (saves cost),
                                    # return an "insufficient" result
